# Servicio de un grupo de MotorRed. Copie como .env y complete.
# GRUPO: taller, tienda, concesionario o ventas
GRUPO=
PUERTO=3000
# Secreto con que este servicio firma sus tokens (largo y al azar):
# SECRETO_JWT_TIENDA=
# Credenciales que este servicio acepta (CLIENTE_<cliente>_EN_<grupo>):
# CLIENTE_TALLER_EN_TIENDA=
# CLIENTE_VENTAS_EN_TIENDA=
# CLIENTE_AUDITOR_EN_TIENDA=
# Rutas de laboratorio /sandbox (solo proveedores). 0 en una demostración pública.
SANDBOX=1
